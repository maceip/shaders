{
  "name": "@maceip/presence-orb",
  "version": "0.1.0",
  "description": "Animated WebGPU presence orb with a separate label and dynamic named attractors",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maceip/shaders.git",
