  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "shaders-core": "workspace:*",
    "@types/react": "^18.2.0",
    "react": "^19.0.0",
    "vite": "npm:rolldown-vite@7.1.16",
    "typescript": "^5.7.2"
  }
